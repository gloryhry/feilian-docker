# Test-only tools: never copy tcpdump or fixtures into the production runtime.
ARG BASE_IMAGE=debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl openssl iproute2 tcpdump ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*
COPY fixtures/integration/ /lab/
WORKDIR /lab
ENTRYPOINT ["python3", "-B", "/lab/service.py"]
