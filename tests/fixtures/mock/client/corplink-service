#!/usr/bin/env python3
"""Local port fixture, NOT FeiLian, gRPC, authentication or a VPN tunnel."""
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import signal
import threading
import time


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        payload = b'{"mock":true,"vpn":false}\n'
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_args):
        pass


stop = threading.Event()
for sig in (signal.SIGTERM, signal.SIGINT):
    signal.signal(sig, lambda *_args: stop.set())
servers = [ThreadingHTTPServer(("127.0.0.1", port), Handler) for port in (31055, 31056)]
for server in servers:
    threading.Thread(target=server.serve_forever, daemon=True).start()
print("MOCK SERVICE: local ports only; no official client, no VPN", flush=True)
while not stop.wait(0.25):
    pass
for server in servers:
    server.shutdown()
    server.server_close()
