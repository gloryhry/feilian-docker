# 复制为 .env 后按需修改
TAG=feilian-gui:3.2.16

# auto = 先试 bridge，出网失败自动切 host
NET_MODE=auto

# vnc = 容器内 Xvfb + x11vnc + noVNC（无需宿主机桌面）
# x11 = 直接用宿主机的 X server（需挂载那个 display 的 socket）
GUI_MODE=vnc
VNC_GEOMETRY=1600x1000x24
NOVNC_PORT=6080

# 留空 = 不设密码（因为只绑 127.0.0.1）
VNC_PASSWORD=

# 需要固定更快的 Debian 源时填，例如 https://mirrors.aliyun.com/debian
DEBIAN_MIRROR=
