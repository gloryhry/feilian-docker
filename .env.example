# 复制为项目根 .env；配置只允许 KEY=字面值、整值引号和整行注释。
# 不支持 export、变量展开、命令替换、转义、空格值或行尾注释。
# 优先级：--set > 进程环境 > .env > 安全默认。禁止 source/eval 此文件。
PROJECT_NAME=feilian
CLIENT_MANIFEST=config/client.lock.json
# 默认由 manifest 的 release.version 派生，避免覆盖旧入口镜像的 tag。
# IMAGE_REF=feilian-gui:3.2.16-wrapper-dev
# 旧 TAG 是 IMAGE_REF 的别名；同一来源中两个值不同会报错。

# auto 仅等同 bridge，绝不会自动回退至 host。
NET_MODE=bridge
ALLOW_HOST_NETWORK=0
HOST_NET_APPLY=0
UP_IF=
PROBE_TIMEOUT=8
STOP_TIMEOUT=20

# Web 默认只绑定宿主回环。非回环必须认证+TLS+明确来源CIDR。
NOVNC_HOST_PORT=6080
NOVNC_INTERNAL_PORT=6080
# 旧 NOVNC_PORT 仅为 NOVNC_HOST_PORT 别名。
WEB_BIND=127.0.0.1
WEB_AUTH=1
WEB_TLS=off
WEB_SOURCE_CIDRS=
WEB_AUTH_FILE=
WEB_TLS_CERT_FILE=
WEB_TLS_KEY_FILE=
GUI_MODE=vnc
VNC_GEOMETRY=1600x1000x24
X11_DISPLAY=
# 兼容空值；非空明文密码会报错且不会输出。请使用secrets文件。
VNC_PASSWORD=
VNC_PASSWORD_FILE=

# 原始代理始终禁止直接暴露LAN；来源ACL不能替代安全的loopback绑定。
PROXY_ENABLED=1
PROXY_REQUIRE_VPN=1
PROXY_BIND=127.0.0.1
HTTP_PROXY_HOST_PORT=8888
HTTP_PROXY_INTERNAL_PORT=8118
SOCKS_PROXY_HOST_PORT=1088
SOCKS_PROXY_INTERNAL_PORT=1080
PROXY_SOURCE_CIDRS=
PROXY_CONNECT_PORTS=443

# 不预填或伪造企业域名/网段/探针，缺少它们不阻止GUI启动。
# FEILIAN_CONFIG_STATUS=UNCONFIGURED只是配置完整度，不代表VPN ready。
CORP_DOMAINS=
CORP_CIDRS=
DNS_MODE=auto
VPN_DNS_SOURCE=file
VPN_DNS=
VPN_CONFIG_FILE=/opt/apps/com.volcengine.feilian/files/vpn.conf
VPN_IFACE=auto
VPN_PROBE_DNS_NAME=
VPN_PROBE_URL=
VPN_PROBE_EXPECT_STATUS=200
# 仅供受信测试CA/企业CA，绝对路径；不支持跳过TLS验证。
VPN_PROBE_CA_FILE=

# 网关仅显式开启，必须填真实source/corp/access网段和access内有效网关IP。
GATEWAY_ENABLED=0
GATEWAY_SOURCE_CIDRS=
ACCESS_SUBNET=
GATEWAY_IP=
MSS_MODE=off
GUARD_ENABLED=1
START_NETWORKMANAGER=1
START_SERVICE=1
START_GUI=1

# host仅在 NET_MODE=host + ALLOW_HOST_NETWORK=1 时允许；须同时关闭上面
# 显式配置的 PROXY_ENABLED、GUARD_ENABLED、START_NETWORKMANAGER，DNS_MODE=off。
# host不允许gateway/MSS/托管DNS等网络变更功能。

# macvlan必须显式填写parent/subnet/ip/gateway，并开启Web认证/TLS与来源ACL。
MACVLAN_PARENT=
MACVLAN_SUBNET=
MACVLAN_GATEWAY=
MACVLAN_IP=
MACVLAN_SHIM=0
MACVLAN_SHIM_IP=

BUILD_PLATFORMS=native
BUILD_OUTPUT=load
BUILD_NETWORK=default
DEBIAN_MIRROR=
NO_CACHE=0
REGISTRY_IMAGE=ghcr.io/gloryhry/feilian-docker
